{
  "name": "pc-lab-3d",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm verify:builder-bundle",
    "verify:builder-bundle": "node scripts/verify-builder-bundle.mjs",
    "backend:test": "mvn -f backend/pom.xml test",
    "backend:package": "mvn -f backend/pom.xml package -DskipTests",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "framer-motion": "^12.43.0",
    "gsap": "3.15.0",
    "ky": "^2.0.2",
    "lucide-react": "1.28.0",
    "meshoptimizer": "1.2.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "three-stdlib": "2.36.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "jsdom": "30.0.1",
    "react-doctor": "^0.9.2",
    "react-grab": "^0.1.50",
    "react-scan": "0.5.7",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
